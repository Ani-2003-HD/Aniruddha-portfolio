# ── Dependencies ───────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ───────────────────────────────────────────────────────
# Vite writes to dist/. build/ is the old Create React App output — kept
# here so a stale one can never be committed by accident.
dist/
build/
dist-ssr/

# ── Caches ─────────────────────────────────────────────────────────────
*.tsbuildinfo
.vite/
.eslintcache
coverage/
*.lcov

# ── Environment ────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.local

# ── Logs ───────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editors ────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ── OS ─────────────────────────────────────────────────────────────────
# No leading slash, so these match at any depth (src/.DS_Store included).
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
